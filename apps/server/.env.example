# ==========================================
# Patra Server Environment Configuration
# ==========================================

# Server
PORT=5001
NODE_ENV=development

# MongoDB Connection
# -------------------------------------------------------------
# Replace this placeholder with your actual MongoDB connection string:
# Local MongoDB example: mongodb://localhost:27017/patra
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/patra?retryWrites=true&w=majority
# -------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/patra?retryWrites=true&w=majority"
MONGO_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/patra?retryWrites=true&w=majority"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration (Backend2-yuvi Standard)
ACCESS_TOKEN_SECRET="patra_jwt_access_secret_super_secure_key_123456789_xyz"
ACCESS_TOKEN_EXPIRY="1d"
REFRESH_TOKEN_SECRET="patra_jwt_refresh_secret_super_secure_key_987654321_abc"
REFRESH_TOKEN_EXPIRY="10d"

# Compatibility Aliases
JWT_ACCESS_SECRET="patra_jwt_access_secret_super_secure_key_123456789_xyz"
JWT_REFRESH_SECRET="patra_jwt_refresh_secret_super_secure_key_987654321_abc"
JWT_SECRET="patra_jwt_access_secret_super_secure_key_123456789_xyz"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="10d"

# Credentials Encryption (32-byte / 64-char hex key for AES-256)
CREDENTIALS_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Provider
RESEND_API_KEY="re_your_api_key_here"

# CORS
CORS_ORIGIN="http://localhost:3000"
