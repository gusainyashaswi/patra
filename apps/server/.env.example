# ==========================================
# Patra Server Environment Configuration
# ==========================================

# Server
PORT=5001
NODE_ENV=development

# MongoDB Connection
# -------------------------------------------------------------
# Replace this placeholder with your actual MongoDB connection string:
# Local Docker Compose example: mongodb://patra:patra@localhost:27017/patra?authSource=admin&replicaSet=rs0
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/patra?retryWrites=true&w=majority
# -------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/patra?retryWrites=true&w=majority"
MONGO_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/patra?retryWrites=true&w=majority"

# Redis & Queue
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=5

# JWT Configuration (Backend2-yuvi Standard)
ACCESS_TOKEN_SECRET="replace-with-a-unique-secret-at-least-32-characters-long"
ACCESS_TOKEN_EXPIRY="1d"
REFRESH_TOKEN_SECRET="replace-with-a-different-unique-secret-at-least-32-characters"
REFRESH_TOKEN_EXPIRY="10d"

# Compatibility Aliases
JWT_ACCESS_SECRET="replace-with-a-unique-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="replace-with-a-different-unique-secret-at-least-32-characters"
JWT_SECRET="replace-with-a-unique-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="10d"

# Credentials Encryption (32-byte / 64-char hex key for AES-256)
# Generate these with `openssl rand -hex 32`; do not commit real values.
CREDENTIALS_KEY="replace-with-a-64-character-hex-key-generated-by-openssl"
ENCRYPTION_KEY="replace-with-a-64-character-hex-key-generated-by-openssl"

# Email Provider
RESEND_API_KEY="re_your_api_key_here"
# Copy this signing secret from the Resend webhook configuration.
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# CORS
CORS_ORIGIN="http://localhost:3000"
