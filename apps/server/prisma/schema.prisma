generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransportType {
  RESEND
  SMTP
  SES
}

enum TransportStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignPriority {
  NORMAL
  URGENT
}

enum RecipientStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  OPENED
  CLICKED
  COMPLAINED
  SKIPPED // suppressed or missing a required variable
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  campaigns     Campaign[]     @relation("CampaignCreator")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // store a hash, never the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  roles            Role[]
  transports       MailTransport[]
  domains          Domain[]
  senders          SenderIdentity[]
  contacts         Contact[]
  lists            List[]
  suppressions     Suppression[]
  templates        Template[]
  templateVersions TemplateVersion[]
  campaigns        Campaign[]
  recipients       CampaignRecipient[]
  auditLogs        AuditLog[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid())
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  organizationId String? // null for system roles shared by all orgs
  createdAt      DateTime @default(now())

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, name])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MailTransport {
  id                   String          @id @default(uuid())
  organizationId       String
  name                 String
  type                 TransportType
  credentialsEncrypted String // AES-GCM ciphertext, encrypted in the app, never returned to clients
  ratePerSecond        Int             @default(2)
  dailyLimit           Int?
  isDefault            Boolean         @default(false)
  status               TransportStatus @default(UNVERIFIED)
  lastTestedAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains      Domain[]
  senders      SenderIdentity[]

  @@index([organizationId])
}

model Domain {
  id               String   @id @default(uuid())
  organizationId   String
  transportId      String
  name             String
  verified         Boolean  @default(false)
  providerDomainId String?
  dnsRecords       Json?
  createdAt        DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transport    MailTransport    @relation(fields: [transportId], references: [id], onDelete: Cascade)
  senders      SenderIdentity[]

  @@unique([organizationId, name])
}

model SenderIdentity {
  id             String   @id @default(uuid())
  organizationId String
  transportId    String
  domainId       String // fromEmail must sit on this domain, enforced in the API
  displayName    String
  fromEmail      String
  replyTo        String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transport    MailTransport @relation(fields: [transportId], references: [id], onDelete: Cascade)
  domain       Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
}

model Contact {
  id             String   @id @default(uuid())
  organizationId String
  email          String // stored lowercased and trimmed
  name           String?
  customFields   Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listMemberships ListContact[]
  recipients      CampaignRecipient[]

  @@unique([organizationId, email])
}

model List {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ListContact[]
  campaigns    Campaign[]

  @@index([organizationId])
}

model ListContact {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
}

model Suppression {
  id             String            @id @default(uuid())
  organizationId String
  email          String
  reason         SuppressionReason
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model Template {
  id               String         @id @default(uuid())
  organizationId   String
  name             String
  status           TemplateStatus @default(DRAFT)
  draftSubject     String?
  draftPreviewText String?
  draftBlocks      Json           @default("{}") // autosaved canvas JSON, never sent directly
  latestVersion    Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]

  @@index([organizationId])
}

model TemplateVersion {
  id             String   @id @default(uuid())
  organizationId String // denormalized so tenant checks skip the join
  templateId     String
  version        Int
  subject        String
  previewText    String?
  blocks         Json
  html           String   @db.Text
  text           String   @db.Text
  variables      String[]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaigns    Campaign[] // campaigns pin this immutable version, not Template

  @@unique([templateId, version])
  @@index([organizationId])
}

model Campaign {
  id                String           @id @default(uuid())
  organizationId    String
  name              String
  status            CampaignStatus   @default(DRAFT)
  priority          CampaignPriority @default(NORMAL)
  templateVersionId String
  senderIdentityId  String
  listId            String
  createdById       String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?

  totalRecipients Int @default(0) // counters kept current by worker and webhooks, so dashboards avoid COUNT(*)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  bouncedCount    Int @default(0)
  failedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion     @relation(fields: [templateVersionId], references: [id])
  senderIdentity  SenderIdentity      @relation(fields: [senderIdentityId], references: [id])
  list            List                @relation(fields: [listId], references: [id])
  createdBy       User?               @relation("CampaignCreator", fields: [createdById], references: [id])
  recipients      CampaignRecipient[]

  @@index([organizationId, status])
}

model CampaignRecipient {
  id                String          @id @default(uuid())
  organizationId    String
  campaignId        String
  contactId         String
  email             String // snapshot at send time, unaffected by later contact edits
  status            RecipientStatus @default(QUEUED)
  providerMessageId String? // webhook events are matched back to this row by this ID
  error             String?
  queuedAt          DateTime        @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId]) // idempotency: one row per person per campaign
  @@index([providerMessageId])
  @@index([organizationId, campaignId, status])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String   @unique // duplicate deliveries are ignored by this constraint
  type            String
  payload         Json
  receivedAt      DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
