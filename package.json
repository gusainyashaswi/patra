{
  "name": "patra",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack mailing service application monorepo",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "migrate": "npm run migrate --workspace=server",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.11.10"
  },
  "workspaces": [
    "apps/*"
  ]
}
