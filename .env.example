# Optional env file loaded by the server and worker in Compose.
PATRA_ENV_FILE=.env

# Local API mode; Compose pins this value.
NODE_ENV=development
# Local API port; Compose pins this value.
PORT=5001
# Mongo replica-set URI; Compose uses this internal service address.
MONGODB_URI="mongodb://mongo:27017/patra?replicaSet=rs0"
# Redis queue URI; Compose uses this internal service address.
REDIS_URL=redis://redis:6379
# Public API origin used in generated email links.
API_URL=http://localhost:5001
# Browser origin allowed by the API.
CORS_ORIGIN=http://localhost:3000
# API base URL built into the browser client.
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Maximum concurrent jobs per worker.
WORKER_CONCURRENCY=5
# Start the worker when its module is imported by another entry point.
PATRA_RUN_WORKER=false
# Enable self-service signup for local Compose.
ALLOW_REGISTRATION=true
# Use the fake delivery transport for local testing.
USE_FAKE_TRANSPORT=false

# Generate a unique JWT access signing secret of at least 32 characters.
# ACCESS_TOKEN_SECRET=replace-with-a-unique-access-signing-secret
# Generate a different JWT refresh signing secret of at least 32 characters.
# REFRESH_TOKEN_SECRET=replace-with-a-unique-refresh-signing-secret
# Access token lifetime.
ACCESS_TOKEN_EXPIRY=1d
# Refresh token lifetime.
REFRESH_TOKEN_EXPIRY=10d
# Generate the AES credentials key with openssl rand -hex 32.
# CREDENTIALS_KEY=replace-with-64-hex-characters
# Legacy alias for the access signing secret.
# JWT_ACCESS_SECRET=replace-with-an-access-signing-secret
# Legacy alias for the refresh signing secret.
# JWT_REFRESH_SECRET=replace-with-a-refresh-signing-secret
# Older alias for the access signing secret.
# JWT_SECRET=replace-with-an-access-signing-secret
# Legacy alias for the access token lifetime.
# JWT_EXPIRES_IN=1d
# Legacy alias for the refresh token lifetime.
# JWT_REFRESH_EXPIRES_IN=10d
# Legacy alias for the credentials encryption key.
# ENCRYPTION_KEY=replace-with-64-hex-characters
# Signing secret from the Resend webhook settings.
# RESEND_WEBHOOK_SECRET=whsec_replace-me

# MinIO username used by Compose for its local bucket.
MINIO_ROOT_USER=patra-local
# MinIO password used by Compose for its local bucket.
MINIO_ROOT_PASSWORD=patra-local-storage-password
# Storage endpoint used by Compose inside its network.
S3_ENDPOINT=http://minio:9000
# Storage signing region used by Compose.
S3_REGION=us-east-1
# Image bucket created and used by Compose.
S3_BUCKET=patra-images
# Storage access key; Compose derives this from the MinIO username.
# S3_ACCESS_KEY_ID=replace-with-storage-access-key
# Storage secret key; Compose derives this from the MinIO password.
# S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
# Public image bucket URL returned to the browser.
S3_PUBLIC_URL=http://localhost:9000/patra-images

# Email used by the separate owner setup command.
# OWNER_EMAIL=owner@example.com
# Password of at least 12 characters used by owner setup.
# OWNER_PASSWORD=replace-with-a-unique-password
# Display name used by owner setup.
# OWNER_NAME=Owner
# Organization display name used by owner setup.
# ORG_NAME=Patra
# Organization URL slug used by owner setup.
# ORG_SLUG=patra

# Worker job lock duration in milliseconds for tests.
# WORKER_LOCK_MS=60000
# Enable the queue load test.
# PATRA_LOAD=0
# Enable the Mailtrap sandbox load test.
# PATRA_MAILTRAP_LOAD=0
# API token for the Mailtrap load test sandbox.
# MAILTRAP_API_TOKEN=replace-with-sandbox-token
# Numeric inbox ID for the Mailtrap load test.
# MAILTRAP_INBOX_ID=123456
# Maximum Mailtrap load test deliveries per second.
# MAILTRAP_RATE_PER_SECOND=1
