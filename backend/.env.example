# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/patra

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# SMTP Provider Configuration
# Leave empty to automatically use Ethereal test account (mock/preview inbox for testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Default Sender
FROM_EMAIL="Patra Mailer" <no-reply@patramail.local>
